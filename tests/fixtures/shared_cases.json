{
  "_comment": [
    "Python 與 TypeScript 兩份平行實作的共用驗證案例。",
    "back_adjust / backAdjust 與 report_window / reportWindow 各有兩份實作，",
    "兩邊必須算出相同結果，否則河流圖畫的線會與估值卡的數字對不上。",
    "",
    "2026-07-22 一天之內就漂移了三次：期數判定跑出 6/8/全歷史三種答案、",
    "P/FCF 的視窗停在 8 期、稽核用真超集判反。純靠人工逐行比對維持一致，",
    "只能證明『比對的那一次』一致。",
    "",
    "跑法：",
    "  python tests/test_shared.py        （Python 端）",
    "  cd frontend && npx tsx ../tests/test_shared.ts   （TypeScript 端）",
    "兩邊讀同一份 JSON，任一邊不符即失敗。"
  ],

  "back_adjust": [
    {
      "name": "配股 12 元＋現金 3 元，還原價應等於交易所公告參考價",
      "source": "1808 潤隆 2024-09-26，TWSE 除權息計算結果表",
      "dates": ["1900-01-01", "2024-09-26"],
      "closes": [119.5, 119.5],
      "ex_list": [["2024-09-26", 3.0, 12.0]],
      "official": null,
      "expect_first": 52.95
    },
    {
      "name": "配股 5 元＋現金 1.5 元",
      "source": "2540 愛山林 2024-09-12",
      "dates": ["1900-01-01", "2024-09-12"],
      "closes": [192.0, 192.0],
      "ex_list": [["2024-09-12", 1.5, 5.0]],
      "official": null,
      "expect_first": 127.0
    },
    {
      "name": "配股與現金各 4.1 元",
      "source": "3056 富華新 2023-08-18",
      "dates": ["1900-01-01", "2023-08-18"],
      "closes": [48.0, 48.0],
      "ex_list": [["2023-08-18", 4.1, 4.1]],
      "official": null,
      "expect_first": 31.13
    },
    {
      "name": "官方因子優先於自算（現金增資，自算會少扣）",
      "source": "8112 至上 2026-07-06，自算得 89.10、公告 87.53",
      "dates": ["1900-01-01", "2026-07-06"],
      "closes": [92.9, 92.9],
      "ex_list": [["2026-07-06", 3.8005, 0.0]],
      "official": { "2026-07-06": 0.94219590958 },
      "expect_first": 87.53
    },
    {
      "name": "只辦現金增資：dividends 表沒有該筆，僅官方因子存在",
      "source": "3028 零壹 2026-07-17，配息配股皆為 0",
      "dates": ["1900-01-01", "2026-07-17"],
      "closes": [100.0, 100.0],
      "ex_list": [],
      "official": { "2026-07-17": 0.925 },
      "expect_first": 92.5
    },
    {
      "name": "減資：參考價高於前收，因子 >1 必須被接受",
      "source": "上限設 5 時會被整筆丟棄；彌補虧損型減資 90% 即為此形",
      "dates": ["1900-01-01", "2026-01-15"],
      "closes": [10.0, 10.0],
      "ex_list": [],
      "official": { "2026-01-15": 10.0 },
      "expect_first": 100.0
    },
    {
      "name": "官方因子超出上限時回退自算，而非整筆跳過",
      "source": "跳過等於那天完全不還原，會留下假跳空",
      "dates": ["1900-01-01", "2026-01-15"],
      "closes": [100.0, 100.0],
      "ex_list": [["2026-01-15", 5.0, 0.0]],
      "official": { "2026-01-15": 999.0 },
      "expect_first": 95.0
    },
    {
      "name": "多次除權息連乘，且官方與自算混用",
      "source": "驗證因子順序與累乘方向",
      "dates": ["2020-01-01", "2021-01-01", "2022-01-01", "2023-01-01"],
      "closes": [100.0, 100.0, 100.0, 100.0],
      "ex_list": [["2021-06-01", 5.0, 0.0], ["2022-06-01", 3.0, 0.0]],
      "official": { "2022-06-01": 0.95 },
      "expect_first": 90.25
    },
    {
      "name": "除權息日早於所有股價時不套用（無基準可算）",
      "source": "i == 0 的邊界",
      "dates": ["2025-01-01", "2025-06-01"],
      "closes": [50.0, 50.0],
      "ex_list": [["2024-01-01", 5.0, 0.0]],
      "official": null,
      "expect_first": 50.0
    },
    {
      "name": "股利大於前收（資料異常）應跳過，不得產生負數或零",
      "source": "f <= 0 的守衛",
      "dates": ["1900-01-01", "2025-06-01"],
      "closes": [10.0, 10.0],
      "ex_list": [["2025-06-01", 20.0, 0.0]],
      "official": null,
      "expect_first": 10.0
    }
  ],

  "report_window": [
    {
      "name": "半年報公司，早年混入一筆 3 月（長亨型）",
      "source": "4546 長亨：唯一的 2020-03-31 曾讓整支股票被判成季報，TTM 高估 71%",
      "quarter_ends": ["2020-03-31", "2023-06-30", "2023-12-31", "2024-06-30",
                       "2024-12-31", "2025-06-30", "2025-12-31"],
      "expect": 2
    },
    {
      "name": "半年報公司，最近第 7 期是 3 月（欣訊型）",
      "source": "5254 欣訊科技：視窗設 8 期仍會誤判，這是取 6 期的理由",
      "quarter_ends": ["2022-06-30", "2022-12-31", "2023-03-31", "2023-06-30",
                       "2023-12-31", "2024-06-30", "2024-12-31", "2025-06-30", "2025-12-31"],
      "expect": 2
    },
    {
      "name": "一般季報公司",
      "source": "2330 台積電",
      "quarter_ends": ["2024-03-31", "2024-06-30", "2024-09-30", "2024-12-31",
                       "2025-03-31", "2025-06-30", "2025-09-30"],
      "expect": 4
    },
    {
      "name": "新上市只有 1 期且落在 12 月：不得判成半年報",
      "source": "月份都在 6/12 對 1~2 期必然成立，判 2 期會讓 TTM 少一半",
      "quarter_ends": ["2025-12-31"],
      "expect": 4
    },
    {
      "name": "新上市只有 2 期：同上",
      "source": "7907 錸恩帕斯曾以 2 期算出 ttm_eps=13.02",
      "quarter_ends": ["2025-06-30", "2025-12-31"],
      "expect": 4
    },
    {
      "name": "半年報滿 3 期即可判定",
      "source": "MIN_PERIODS_TO_JUDGE 的邊界",
      "quarter_ends": ["2024-12-31", "2025-06-30", "2025-12-31"],
      "expect": 2
    },
    {
      "name": "季報缺 Q4，月份集合為 {3,6,9}",
      "source": "稽核曾用真超集判定，{3,6,9} > {6,12} 為 False 而誤判",
      "quarter_ends": ["2025-03-31", "2025-06-30", "2025-09-30", "2026-03-31"],
      "expect": 4
    },
    {
      "name": "空序列採季報",
      "source": "無從判斷時的預設",
      "quarter_ends": [],
      "expect": 4
    },
    {
      "name": "順序打亂不影響結果",
      "source": "內部自行排序",
      "quarter_ends": ["2025-12-31", "2020-03-31", "2025-06-30", "2024-12-31",
                       "2024-06-30", "2023-12-31", "2023-06-30"],
      "expect": 2
    }
  ]
}
